{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue", "vitest"],
  "ignorePatterns": [
    ".agents",
    "dist",
    "test-results",
    "playwright-report",
    "coverage"
  ],
  "env": {
    "browser": true
  },
  "categories": {
    "correctness": "error"
  }
}
